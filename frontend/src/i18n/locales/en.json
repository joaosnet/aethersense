        "tag": "3D Spectrum & Harmonics",
        "title": "3D FFT Spectrum: Physiological Bands & Rejected Harmonics",
        "subtitle": "3D decomposition (Fourier Series style) isolating in layers: raw spectrum, breathing band (0.1–0.5 Hz), rejected breathing harmonics, and cardiac band (0.8–2.0 Hz).",
        "validation": "Rotate and zoom in 3D to inspect physical isolation: suppressed harmonics prevent the cardiac search from hallucinating heartbeats on breathing multiples."
      },
      "heatmap": {
        "tag": "Base Signal",
        "title": "CSI Amplitude per Subcarrier",
        "subtitle": "Amplitude matrix used as signal evidence and foundation for operational history.",
        "validation": "Expected continuity across packets and coherent changes during movement; broken lines or zeroed blocks indicate packet loss, incorrect parser, or invalid payload."
      },
      "stft": {
        "tag": "M6 Benchmark",
        "title": "STFT of Mean Amplitude",
        "subtitle": "Hanning-windowed FFT for time-frequency inspection and benchmarking.",
        "validation": "Validate temporal/frequency separation and M6 dynamic range; excessive leakage or spread energy suggests poor windowing, noise, or unstable capture."
      },
      "pca": {
        "tag": "M6 Benchmark",
        "title": "PCA of CSI Amplitudes",
        "subtitle": "Power iteration over the amplitude window; used for analysis and benchmarking.",
        "validation": "Expected to see components with consistent trajectories; scattered clouds without structure indicate poor separation between static state, movement, and noise."
      },
      "phase": {
        "tag": "Observability",
        "title": "Raw vs Sanitized Phase",
        "subtitle": "M6 Observability and benchmark; does not trigger automation directly.",
        "validation": "Validate if sanitized phase reduces slope and jumps from raw phase; large residuals point to CFO/SFO, weak unwrap, or unstable environment."
      },
      "pdp": {
        "tag": "Observability",
        "title": "PDP via CSI IFFT",
        "subtitle": "Multipath profile of current packet; visualization only, not operational decision.",
        "validation": "Expected to see relatively stable multipath peaks in an empty room; erratic or flattened peaks suggest poor channel quality or noisy CSI."
