FROM rust:1.94.1-slim-trixie

WORKDIR /app

# Instala dependências de build necessárias para compilar crates C e watch
RUN apt-get update && apt-get install -y pkg-config libssl-dev curl && rm -rf /var/lib/apt/lists/*

# Instala o cargo-watch para live reload (utilizamos o binário pré-compilado ou instalamos via cargo)
# A instalação via cargo install pode demorar a primeira vez, mas o volume cargo_registry fará cache
RUN cargo install cargo-watch --locked

EXPOSE 8000
EXPOSE 5005/udp

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD curl -fsS --max-time 2 http://127.0.0.1:8000/api/health

# O cargo-watch observará as mudanças de arquivos dentro de /app/src e executará "cargo run"
CMD ["cargo", "watch", "-x", "run"]
